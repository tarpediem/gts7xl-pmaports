406bab7aeb03f008fffec9191c30ebe3c90c6043a2aa02c07c75543f271019bba875547ffa8eb68fa0802e3b21a2c6d9983d8b2c29c0a0ad27475c0b3f3a87a5  config-samsung-gts7xl.aarch64
7a204395b5be27b4af1828cd46ab6753288b0157bb01cdc46a6d3953ba23ea0b5300ab1bec7fac5730abb989dcd1eb6f53c411631cdbde136eafe81a4492ace0  0001-arm64-dts-qcom-sm8250-add-Samsung-Galaxy-Tab-S7-5G-s.patch
