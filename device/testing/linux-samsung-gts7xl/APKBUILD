# Maintainer: tarpediem <tarpediem@gmail.com>
# Kernel config based on: linux-postmarketos-qcom-sm8250 (refreshed with olddefconfig)
pkgname=linux-samsung-gts7xl
pkgver=7.3.4
pkgrel=5
pkgdesc="Mainline kernel for Samsung Galaxy Tab S7+ 5G (gts7xl)"
arch="aarch64"
_carch="arm64"
_flavor="samsung-gts7xl"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
"
source="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
	config-$_flavor.$arch
	0001-arm64-dts-qcom-sm8250-add-Samsung-Galaxy-Tab-S7-5G-s.patch
	0002-arm64-dts-qcom-sm8250-samsung-gts7xl-memory-map-psto.patch
	0003-Input-pm8941-pwrkey-select-the-warm-PS_HOLD-reset-at.patch
	0004-arm64-dts-qcom-sm8250-samsung-gts7xl-keep-the-bootlo.patch
	0005-drm-panel-add-Samsung-S6TUUM3-AMSA24VU01-panel-drive.patch
	0006-arm64-dts-qcom-sm8250-samsung-gts7xl-enable-the-disp.patch
	"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot

	if [ -e "$builddir/arch/$_carch/boot/vmlinuz.efi" ]; then
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" \
			"$pkgdir/boot/linux.efi"
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" \
			"$pkgdir/boot/vmlinuz"
	else
		install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
			"$pkgdir/boot/vmlinuz"
	fi

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}
