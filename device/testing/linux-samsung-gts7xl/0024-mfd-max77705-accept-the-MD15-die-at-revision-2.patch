From 05a0bb6d239052bbda92f41aadfa24e01a795b88 Mon Sep 17 00:00:00 2001
From: tarpediem <tarpediem@gmail.com>
Date: Tue, 17 Nov 2026 18:55:24 +0700
Subject: [PATCH] mfd: max77705: accept the MD15 die at revision 2

The probe only accepts PMICREV PASS3. The Galaxy Tab S7+ (gts7xl) has
PMICID1 0x15, PMICREV 0x02, which the vendor driver lists as
{id 0x15, rev 2} = "MD15 PASS2" (logical PASS5) and handles exactly like
PASS2-PASS4: the charger interrupt register is read the same way, and
neither the vendor charger nor the fuel gauge driver depends on the
revision (the only revision-specific code is the USB-C firmware, which
this driver does not touch). Read PMICID1 too and accept that one pair,
in addition to PASS3; any other revision is still refused.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mfd/max77705.c               | 19 ++++++++++++++++---
 include/linux/mfd/max77705-private.h |  1 +
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/drivers/mfd/max77705.c b/drivers/mfd/max77705.c
index e98c76d6b..b146f2283 100644
--- a/drivers/mfd/max77705.c
+++ b/drivers/mfd/max77705.c
@@ -85,7 +85,7 @@ static int max77705_i2c_probe(struct i2c_client *i2c)
 	struct regmap_irq_chip_data *irq_data;
 	struct irq_domain *domain;
 	enum max77705_hw_rev pmic_rev;
-	unsigned int pmic_rev_value;
+	unsigned int pmic_rev_value, pmic_id;
 	int ret;
 
 	max77705 = devm_kzalloc(dev, sizeof(*max77705), GFP_KERNEL);
@@ -104,9 +104,22 @@ static int max77705_i2c_probe(struct i2c_client *i2c)
 	if (ret < 0)
 		return -ENODEV;
 
+	ret = regmap_read(max77705->regmap, MAX77705_PMIC_REG_PMICID1, &pmic_id);
+	if (ret < 0)
+		return -ENODEV;
+
+	/*
+	 * PASS3 as before, plus the MD15 die (PMICID1 0x15) at revision 2,
+	 * which the vendor driver lists as {0x15, 2, PASS5} and handles like
+	 * PASS2-PASS4 (same charger interrupt register read). Nothing else in
+	 * the MFD, charger or fuel gauge depends on the revision.
+	 */
 	pmic_rev = pmic_rev_value & MAX77705_REVISION_MASK;
-	if (pmic_rev != MAX77705_PASS3)
-		return dev_err_probe(dev, -ENODEV, "Rev.0x%x is not tested\n", pmic_rev);
+	if (pmic_rev != MAX77705_PASS3 &&
+	    !(pmic_id == MAX77705_PMICID_MD15 && pmic_rev == MAX77705_PASS2))
+		return dev_err_probe(dev, -ENODEV, "ID 0x%x Rev.0x%x is not tested\n",
+				     pmic_id, pmic_rev);
+	dev_info(dev, "PMIC ID 0x%x, revision 0x%x\n", pmic_id, pmic_rev);
 
 	/* Active Discharge Enable */
 	regmap_update_bits(max77705->regmap, MAX77705_PMIC_REG_MAINCTRL1, 1, 1);
diff --git a/include/linux/mfd/max77705-private.h b/include/linux/mfd/max77705-private.h
index 214de7fee..1cd559832 100644
--- a/include/linux/mfd/max77705-private.h
+++ b/include/linux/mfd/max77705-private.h
@@ -19,6 +19,7 @@
 /* MAX77705_PMIC_REG_PMICREV register */
 #define MAX77705_VERSION_SHIFT	3
 #define MAX77705_REVISION_MASK	GENMASK(2, 0)
+#define MAX77705_PMICID_MD15	0x15
 #define MAX77705_VERSION_MASK	GENMASK(7, MAX77705_VERSION_SHIFT)
 /* MAX77705_PMIC_REG_MAINCTRL1 register */
 #define MAX77705_MAINCTRL1_BIASEN_SHIFT	7
-- 
2.56.0

