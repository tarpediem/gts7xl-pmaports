From e3daa7d7eddd89be8d61dd2504d281c7ba7107f2 Mon Sep 17 00:00:00 2001
From: tarpediem <tarpediem@gmail.com>
Date: Tue, 17 Nov 2026 11:49:13 +0700
Subject: [PATCH 15/17] dt-bindings: dma: qcom,gpi: add qcom,gpi-ee-offset

Some firmware partitions the GSI between execution environments
differently from the SoC default (the Samsung SM8250 stock tree uses
0x1000 for QUPv3_0 and 0x6000 for the other two). Allow the board DT to
give the offset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Documentation/devicetree/bindings/dma/qcom,gpi.yaml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/dma/qcom,gpi.yaml b/Documentation/devicetree/bindings/dma/qcom,gpi.yaml
index 54dca6232..eb1324303 100644
--- a/Documentation/devicetree/bindings/dma/qcom,gpi.yaml
+++ b/Documentation/devicetree/bindings/dma/qcom,gpi.yaml
@@ -86,6 +86,13 @@ properties:
 
   dma-coherent: true
 
+  qcom,gpi-ee-offset:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Offset subtracted from the register base to reach the registers of
+      the execution environment Linux runs in. Overrides the SoC default
+      when the firmware partitions the GSI differently.
+
 required:
   - compatible
   - reg
-- 
