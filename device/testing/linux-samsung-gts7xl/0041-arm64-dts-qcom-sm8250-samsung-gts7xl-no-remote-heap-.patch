From 2f8d5bf0dee88a6928cb2fd37e7325c37b19b658 Mon Sep 17 00:00:00 2001
From: tarpediem <tarpediem@gmail.com>
Date: Wed, 18 Nov 2026 07:07:32 +0700
Subject: [PATCH 2/2] arm64: dts: qcom: sm8250-samsung-gts7xl: no remote heap
 for ADSP FastRPC

After a kexec the heap still belongs to the LPASS VMs, the SCM assign of
the FastRPC probe fails with -22 and the channel probe loops (about
70000 kernel errors per boot). Nothing here uses ADSP FastRPC.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
index 651abfa54..d4c4dab68 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
@@ -404,6 +404,19 @@ &adsp {
 	firmware-name = "qcom/sm8250/samsung/gts7xl/adsp.mbn";
 
 	status = "okay";
+
+	/*
+	 * No remote heap for the ADSP FastRPC channel (nothing here uses ADSP
+	 * FastRPC): its probe hands the heap to the LPASS VMs with an SCM call;
+	 * after a kexec the heap still belongs to them, the call fails (-22) and
+	 * the channel probe loops (~70000 errors per boot).
+	 */
+	glink-edge {
+		fastrpc {
+			/delete-property/ memory-region;
+			/delete-property/ qcom,vmids;
+		};
+	};
 };
 
 &apps_rsc {
