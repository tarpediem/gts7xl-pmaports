From 8cc2c9ff32421a3e25b8bd7f5483a88d042a817a Mon Sep 17 00:00:00 2001
From: tarpediem <tarpediem@gmail.com>
Date: Wed, 18 Nov 2026 08:39:32 +0700
Subject: [PATCH 45/45] arm64: dts: qcom: sm8250-samsung-gts7xl: Type-C input
 limits, charger thermistor

Input limit for a Type-C source advertising 1.5 A / 3.0 A: 1400 / 3000 mA,
the stock rp_current_rp2 / rp_current_rp3. Describe the charger
thermistor (PM8150L AMUX THM3, the stock battery's "adc-chg-temp"
channel) as an ADC channel, read only, for monitoring.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8250-samsung-gts7xl.dts      | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
index 6711f573f..069f1f290 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
@@ -661,6 +661,14 @@ max77705_charger: charger@69 {
 		maxim,dcp-input-current-limit-microamp = <1800000>;
 		/* stock charges at 2100 mA on a TA (cable-info default_charging_current) */
 		maxim,dcp-constant-charge-current-microamp = <1500000>;
+		/*
+		 * Type-C current advertisement (sink, VBUS present): stock
+		 * rp_current_rp2 0x578 = 1400 mA, rp_current_rp3 0xbb8 = 3000 mA.
+		 * The larger of this and the BC1.2 value is the input limit; the
+		 * charge current still follows BC1.2 only.
+		 */
+		maxim,typec-1500ma-input-current-limit-microamp = <1400000>;
+		maxim,typec-3000ma-input-current-limit-microamp = <3000000>;
 		maxim,safety-timer-sec = <36000>;
 	};
 
@@ -924,6 +932,14 @@ channel@4d {
 		qcom,hw-settle-time = <200>;
 		label = "batt_therm";
 	};
+
+	/* charger thermistor (stock battery io-channel "adc-chg-temp"), read only */
+	channel@4f {
+		reg = <ADC5_AMUX_THM3_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		label = "chg_therm";
+	};
 };
 
 &pm8150l_gpios {
