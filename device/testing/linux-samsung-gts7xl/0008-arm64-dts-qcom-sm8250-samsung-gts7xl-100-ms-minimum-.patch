From 93877676c542b6be8426c13aa26fd6c54c1de069 Mon Sep 17 00:00:00 2001
From: tarpediem <tarpediem@gmail.com>
Date: Tue, 17 Nov 2026 10:49:17 +0700
Subject: [PATCH 8/8] arm64: dts: qcom: sm8250-samsung-gts7xl: 100 ms minimum
 panel off time

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
index 937d80c36..3ef13f791 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-samsung-gts7xl.dts
@@ -84,6 +84,8 @@ vreg_panel: regulator-panel {
 		gpio = <&tlmm 135 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 		regulator-boot-on;
+		/* margin: never re-power the module right after cutting it */
+		off-on-delay-us = <100000>;
 
 		pinctrl-names = "default";
 		pinctrl-0 = <&panel_vdd_en>;
-- 
