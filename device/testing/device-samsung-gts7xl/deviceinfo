# First-boot cmdline:
# - console=tty0: kernel log on the bootloader framebuffer (simple-framebuffer);
# - clk_ignore_unused pd_ignore_unused: keep what the bootloader turned on (display);
# - cpuidle.off=1: no deep idle yet (the stock cmdline has lpm_levels.sleep_disabled=1);
# - panic=5: reboot after a panic, the log stays in ramoops for One UI;
# - pmos.debug-shell: the initramfs stops in its debug shell (telnet 172.16.42.1 over
#   USB, getty on the screen) instead of looking for a root filesystem.
deviceinfo_kernel_cmdline="console=tty0 clk_ignore_unused pd_ignore_unused cpuidle.off=1 panic=5 pmos.debug-shell"
deviceinfo_generate_bootimg="true"
deviceinfo_header_version="2"
deviceinfo_bootimg_qcdt="false"
# UFS with 4096-byte logical blocks (sda37 = userdata): the nested GPT of the
# rootfs image must use the same sector size or the initramfs finds no subpartitions.
deviceinfo_rootfs_image_sector_size="4096"
# "none": pmbootstrap flasher must never write to this device (it would flash the
# unsigned boot.img without the disabled vbmeta). The only flash path is
# tools/flash.sh in the gts7xl-mainline repo; the partition names below are
# kept as documentation.
deviceinfo_flash_method="none"
deviceinfo_flash_heimdall_partition_kernel="BOOT"
deviceinfo_flash_heimdall_partition_rootfs="USERDATA"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x02000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x01e00000"
deviceinfo_flash_offset_dtb="0x01f00000"
