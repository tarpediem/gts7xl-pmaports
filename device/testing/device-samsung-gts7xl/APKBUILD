# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-gts7xl
pkgdesc="Samsung Galaxy Tab S7+ 5G"
pkgver=1
pkgrel=14
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="postmarketos-base linux-samsung-gts7xl mkbootimg i2c-tools kexec-tools
	linux-firmware-ath11k linux-firmware-qca iw bluez-btmgmt"
makedepends="devicepkg-dev"
install="$pkgname-hyprland.post-install"
subpackages="$pkgname-sshd-keyonly:sshd_keyonly:noarch
	$pkgname-bluetooth:bluetooth:noarch
	$pkgname-polkit:polkit_rules:noarch
	$pkgname-console:console:noarch
	$pkgname-nonfree-firmware:nonfree_firmware:noarch
	$pkgname-hyprland:hyprland:noarch"
source="deviceinfo
	00-gts7xl-usb-muic.sh
	50-gts7xl-modules.sh
	60-gts7xl-powerkey.sh
	30-gts7xl.files
	30-gts7xl.modules
	initramfs-modprobe.conf
	sshd-keyonly.conf
	gts7xl-bt-addr.sh
	gts7xl-bt-addr.service
	gts7xl-bt-addr.conf
	gts7xl-bt-hid.conf
	gts7xl-wheel.rules
	gts7xl-powerkey.service
	gts7xl-console.sysctl
	gts7xl-hyprland
	gts7xl-hypr-dpms
	hypr-hyprland.conf
	hypr-waybar.jsonc
	hypr-waybar.css
	hypr-foot.ini
	hypr-greetd.toml
	"

build() { devicepkg_build $startdir $pkgname; }
package() {
	devicepkg_package $startdir $pkgname

	# USB data lines go through the MAX77705 MUIC: see the hook.
	install -Dm755 "$srcdir"/00-gts7xl-usb-muic.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks
	install -Dm644 "$srcdir"/30-gts7xl.files \
		-t "$pkgdir"/usr/share/mkinitfs/files

	# Touchscreen module: in the initramfs, blacklisted for udev there,
	# loaded by the hook once the USB debug shell is up. kexec for USB
	# iteration (docs/runbooks/iterate-over-usb.md in gts7xl-mainline).
	install -Dm755 "$srcdir"/50-gts7xl-modules.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks
	install -Dm644 "$srcdir"/30-gts7xl.modules \
		-t "$pkgdir"/usr/share/mkinitfs/modules
	install -Dm644 "$srcdir"/initramfs-modprobe.conf \
		-t "$pkgdir"/usr/share/gts7xl

	# Short power-key press toggles the display and the touchscreen
	# in the debug shell.
	install -Dm755 "$srcdir"/60-gts7xl-powerkey.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks
}

sshd_keyonly() {
	pkgdesc="SSH login with a key only (no password, no root)"
	depends="openssh-server"
	install -Dm644 "$srcdir"/sshd-keyonly.conf \
		"$subpkgdir"/etc/ssh/sshd_config.d/40-gts7xl-keyonly.conf
}

bluetooth() {
	pkgdesc="bluez with a stable hci0 address (from /etc/machine-id) and HID modules"
	depends="bluez bluez-btmgmt"
	install -Dm755 "$srcdir"/gts7xl-bt-addr.sh "$subpkgdir"/usr/libexec/gts7xl-bt-addr
	install -Dm644 "$srcdir"/gts7xl-bt-addr.service \
		-t "$subpkgdir"/usr/lib/systemd/system
	install -Dm644 "$srcdir"/gts7xl-bt-addr.conf \
		-t "$subpkgdir"/usr/lib/systemd/system/bluetooth.service.d
	install -Dm644 "$srcdir"/gts7xl-bt-hid.conf \
		-t "$subpkgdir"/usr/lib/modules-load.d
}

polkit_rules() {
	pkgdesc="polkit: wheel manages NetworkManager and power off/reboot without a prompt"
	depends="polkit"
	install -Dm644 "$srcdir"/gts7xl-wheel.rules \
		"$subpkgdir"/usr/share/polkit-1/rules.d/40-gts7xl-wheel.rules
}

hyprland() {
	pkgdesc="Hyprland on tty1 (greetd autologin), touch-friendly bar, on-screen keyboard"
	depends="hyprland greetd greetd-tuigreet foot waybar fuzzel wvkbd swaybg brightnessctl
		grim slurp jq networkmanager-tui font-jetbrains-mono-nerd xdg-desktop-portal-hyprland"
	install -Dm755 "$srcdir"/gts7xl-hyprland "$srcdir"/gts7xl-hypr-dpms -t "$subpkgdir"/usr/bin
	local f
	for f in hyprland.conf waybar.jsonc waybar.css foot.ini greetd.toml; do
		install -Dm644 "$srcdir"/hypr-$f "$subpkgdir"/usr/share/gts7xl/hyprland/$f
	done
}

nonfree_firmware() {
	pkgdesc="GPU and audio DSP firmware: Adreno 650 SQE/GMU (linux-firmware), the device zap shader and ADSP image"
	# firmware-samsung-gts7xl-gpu and -adsp are built locally only (Samsung-signed
	# files, see their APKBUILDs); without them the GPU stays off (zap load fails,
	# display works) and there is no sound card (ADSP does not boot).
	depends="linux-firmware-qcom firmware-samsung-gts7xl-gpu firmware-samsung-gts7xl-adsp
		alsa-ucm-conf-samsung-gts7xl"
	mkdir -p "$subpkgdir"
}

console() {
	pkgdesc="Console UI: power key blanks the screen, quiet screen console"
	install -Dm755 "$srcdir"/60-gts7xl-powerkey.sh "$subpkgdir"/usr/libexec/gts7xl-powerkey
	install -Dm644 "$srcdir"/gts7xl-powerkey.service \
		-t "$subpkgdir"/usr/lib/systemd/system
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../gts7xl-powerkey.service \
		"$subpkgdir"/usr/lib/systemd/system/multi-user.target.wants/gts7xl-powerkey.service
	install -Dm644 "$srcdir"/gts7xl-console.sysctl \
		"$subpkgdir"/usr/lib/sysctl.d/60-gts7xl-console.conf
}

