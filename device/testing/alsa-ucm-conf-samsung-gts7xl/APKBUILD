# Maintainer: tarpediem <tarpediem@gmail.com>
pkgname=alsa-ucm-conf-samsung-gts7xl
pkgver=1
pkgrel=1
pkgdesc="ALSA UCM and WirePlumber configuration for the Samsung Galaxy Tab S7+ 5G speakers"
url="https://github.com/tarpediem/gts7xl-mainline"
arch="noarch"
license="BSD-3-Clause"
depends="alsa-ucm-conf"
source="
	card.conf
	HiFi.conf
	51-gts7xl-speakers.conf
"
options="!check"
builddir="$srcdir"

package() {
	# conf.d/<card driver>/<card name>.conf; the card name is the DT model
	install -Dm644 card.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/Samsung Galaxy Tab S7+ 5G.conf"
	install -Dm644 HiFi.conf -t "$pkgdir/usr/share/alsa/ucm2/Samsung/gts7xl"
	# PipeWire must open the speakers in S16LE (S24_LE is about 48 dB too quiet)
	install -Dm644 51-gts7xl-speakers.conf \
		-t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d"
}
sha512sums="
